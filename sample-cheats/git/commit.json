{
    "Description": "record changes to the git repository",
    "Command": [
        {
            "$type": "CommandTokenLiteral",
            "Value": "git"
        },
        {
            "$type": "CommandTokenLiteral",
            "Value": "commit"
        },
        {
            "$type": "CommandTokenLiteral",
            "Value": "-m"
        },
        {
            "$type": "CommandTokenVariable",
            "Name": "message",
            "Suggester": {
                "$type": "ArgumentSuggesterEmpty"
            }
        }
    ],
    "ExtraArguments": true
}