{
  "description": "运行一个容器",
  "extra_args": true,
  "command": [
    { "type": "literal", "value": "docker" },
    { "type": "literal", "value": "run" },
    { "type": "literal", "value": "--rm" },
    { "type": "literal", "value": "-it" },
    {
      "type": "variable",
