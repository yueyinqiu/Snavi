        "command": [
          { "type": "literal", "value": "docker" },
          { "type": "literal", "value": "images" },
          { "type": "literal", "value": "--format" },
          { "type": "literal", "value": "{{.Repository}}:{{.Tag}}" }
        ]
      }
    }
  ]
}
