{
  "Description": "删除远程分支",
  "Command": [
    { "$type": "CommandTokenLiteral", "Value": "git" },
    { "$type": "CommandTokenLiteral", "Value": "push" },
    { "$type": "CommandTokenLiteral", "Value": "--delete" },
    {
      "$type": "CommandTokenVariable",
      "Name": "远程",
      "Provider": {
        "$type": "ArgumentProviderCsharp",
        "DotnetPath": "dotnet",
        "ScriptPath": "list_remotes.cs"
      }
    },
    {
      "$type": "CommandTokenVariable",
      "Name": "分支",
      "Provider": {
        "$type": "ArgumentProviderCsharp",
        "DotnetPath": "dotnet",
        "ScriptPath": "list_remote_branches.cs"
      }
    }
  ],
  "ExtraArguments": false
}
